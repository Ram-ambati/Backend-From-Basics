{
  "name": "backend-ffp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-static.js && vite build --outDir dist/client && cross-env VITE_SSR=true vite build --outDir dist/server && node scripts/prerender.js",
    "lint": "oxlint",
    "preview": "npm run build && vite preview --outDir dist/client"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "eslint-plugin-ssr-friendly": "^1.3.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
